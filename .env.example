APP_ENV=development
APP_ORIGIN=http://localhost:3100
API_ORIGIN=http://127.0.0.1:8100
PUBLIC_API_ORIGIN=http://localhost:8100
DATABASE_URL=sqlite:///./data/studio.db
# PostgreSQL: use DATABASE_URL with sslmode=require. Supabase port 6543 is the
# IPv4 transaction pooler; copy the exact host and project username from Connect.
# Azure is the production object store. Local files are for credential-free development.
OBJECT_STORAGE_PROVIDER=local
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_ACCOUNT_URL=
AZURE_STORAGE_CONTAINER=voice-studio
AZURE_STORAGE_PREFIX=
# Existing retrieval infrastructure; provider/model/dimension to be supplied.
EMBEDDING_PROVIDER=openai-compatible
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
VECTOR_PROVIDER=qdrant
VECTOR_ENDPOINT=http://127.0.0.1:6333
# Generate privately with scripts/setup_qdrant.py; shared with the Qdrant service.
VECTOR_API_KEY=
VECTOR_COLLECTION=voice-studio
SESSION_SECURE=false
# Set in production. Development generates a local signing secret, mode 0600.
APP_SECRET=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
OPENAI_BASE_URL=https://api.openai.com/v1
# auto: Responses for the official OpenAI host, Chat Completions for compatible hosts.
OPENAI_API_STYLE=auto
OPENAI_TOKEN_PARAMETER=auto
OPENAI_REASONING_EFFORT=auto
FISH_API_KEY=
FISH_VOICE_ID=
FISH_TTS_MODEL=s2.1-pro
DEEPGRAM_API_KEY=
DEEPGRAM_LANGUAGE=en
PLIVO_AUTH_ID=
PLIVO_AUTH_TOKEN=
PLIVO_CALLER_ID=
MEDIA_PUBLIC_ORIGIN=
LIVE_CALLS_ENABLED=false
# Enable only after operator setup, balance checks and public Twilio acceptance.
PHONE_TRIALS_ENABLED=false
BETA_OPERATOR_EMAIL=
TEST_DESTINATION_ALLOWLIST=
RAZORPAY_MODE=test
RAZORPAY_TEST_KEY_ID=
RAZORPAY_TEST_KEY_SECRET=
RAZORPAY_LIVE_KEY_ID=
RAZORPAY_LIVE_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
LIVE_PAYMENTS_ENABLED=false
DEV_SEED_ENABLED=true

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Voice Studio <noreply@localhost>
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_CALLER_ID=

# Beta identity and deployment. Enter credentials privately; never use NEXT_PUBLIC for secrets.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SMTP_SECURITY=starttls
REQUIRE_EMAIL_VERIFICATION=true
ACCESS_TOKEN_SECONDS=900
SESSION_DAYS=7
MAX_ACCOUNT_SESSIONS=10
WORKSPACE_DAILY_TURN_LIMIT=2000
WORKSPACE_VOICE_CONCURRENCY=2
PUBLIC_HOST=docs.cynerza.in
# Schema maintenance must target the same database as DATABASE_URL; its role can
# have extra DDL permissions. A second Supabase project is a separate database.
MIGRATION_DATABASE_URL=

# Optional Twilio API key pair; keep Auth Token for signed callbacks.
# Automatic US trial assignment: pool ID is printed by the configure CLI.
# Purchases remain disabled; caps below are USD cents for quoted rental.
TWILIO_API_KEY=
TWILIO_API_SECRET=
PHONE_TRIAL_AUTO_ASSIGN_POOL_ID=
PHONE_NUMBER_PURCHASES_ENABLED=false
PHONE_NUMBER_MAX_MONTHLY_PRICE_MINOR=150
PHONE_NUMBER_TOTAL_BUDGET_MINOR=1500

# Scheduling OAuth apps: register the documented exact callback URLs.
CALCOM_CLIENT_ID=
CALCOM_CLIENT_SECRET=
CALCOM_OAUTH_MODE=confidential
CALENDLY_CLIENT_ID=
CALENDLY_CLIENT_SECRET=

# Optional derived-vector cache; use a private authenticated Redis instance.
REDIS_URL=
REDIS_PASSWORD=
CRAWL_CONCURRENCY=4
# Local API can run jobs itself. Compose disables its dispatcher and starts worker.
WORKER_ENABLED=true
WORKER_CONCURRENCY=4
WORKER_POLL_SECONDS=0.25
# Per worker, shared across its simultaneous jobs; keep Chromium memory bounded.
RENDER_CONCURRENCY=2
INDEX_CONCURRENCY=2
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=5

# Portable default for local machines and ordinary Docker hosts.
# Only restricted cloud launches should override PUBLIC_NETWORK_MODE=proxy.
PUBLIC_NETWORK_MODE=direct
PUBLIC_HTTP_PROXY=

# Browser and phone voice; text chat retains OPENAI_* settings.
VOICE_PROVIDER=sarvam
SARVAM_API_KEY=
SARVAM_STT_MODEL=saaras:v4
SARVAM_VOICE_MODEL=sarvam-105b-conversations
SARVAM_TTS_MODEL=bulbul:v4-flash
SARVAM_VOICE_ID=simran_enhi_customer
SARVAM_LANGUAGE=auto
SARVAM_ENDPOINTING_MS=250

# Public widget bot check: disabled for beta. Enable after configuring real keys.
WIDGET_BOT_CHALLENGE_ENABLED=false
WIDGET_DAILY_SESSIONS=1000
WIDGET_DAILY_TURNS=5000
WIDGET_IP_DAILY_SESSIONS=100
WIDGET_IP_DAILY_TURNS=1000
WIDGET_MONTHLY_SPEND_CAP_MINOR=100000
WIDGET_VOICE_MAX_SECONDS=300
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
