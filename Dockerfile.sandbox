FROM ghcr.io/astral-sh/uv:0.12.24 AS uv
FROM python:3.13-slim
COPY --from=uv /uv /usr/local/bin/uv
WORKDIR /app
COPY pyproject.toml uv.lock ./
RUN --mount=type=secret,id=cloud_ca if [ -f /run/secrets/cloud_ca ]; then SSL_CERT_FILE=/run/secrets/cloud_ca uv sync --frozen --no-dev; else uv sync --frozen --no-dev; fi
RUN --mount=type=secret,id=cloud_ca sed -i 's|http://deb.debian.org|https://deb.debian.org|g' /etc/apt/sources.list.d/debian.sources && \
    if [ -f /run/secrets/cloud_ca ]; then cp /run/secrets/cloud_ca /usr/local/share/ca-certificates/cloud-build.crt; update-ca-certificates; fi && \
    http_proxy="$HTTP_PROXY" https_proxy="$HTTPS_PROXY" apt-get update && \
    http_proxy="$HTTP_PROXY" https_proxy="$HTTPS_PROXY" apt-get install -y --no-install-recommends chromium ffmpeg fonts-noto-core && \
    rm -rf /var/lib/apt/lists/*
COPY --chmod=0555 sandbox_runtime /runtime
USER 0:0
ENV PATH=/app/.venv/bin:/usr/bin:/bin PYTHONUNBUFFERED=1
CMD ["python","-I","/runtime/broker.py"]
