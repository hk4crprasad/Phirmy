FROM ghcr.io/astral-sh/uv:0.12.24 AS uv
FROM python:3.13-slim
COPY --from=uv /uv /usr/local/bin/uv
WORKDIR /app
COPY pyproject.toml uv.lock ./
RUN --mount=type=secret,id=cloud_ca if [ -f /run/secrets/cloud_ca ]; then SSL_CERT_FILE=/run/secrets/cloud_ca uv sync --frozen --no-dev; else uv sync --frozen --no-dev; fi
RUN apt-get update && apt-get install -y --no-install-recommends chromium && rm -rf /var/lib/apt/lists/*
COPY --chown=10001:10001 services/control services/control
COPY --chown=10001:10001 packages/contracts packages/contracts
COPY --chown=10001:10001 config config
COPY --chown=10001:10001 scripts/migrate_database.py scripts/migrate_database.py
COPY --chown=10001:10001 scripts/grant_runtime_database.py scripts/grant_runtime_database.py
COPY --chown=10001:10001 scripts/backup_production.py scripts/backup_production.py
COPY --chown=10001:10001 scripts/reconcile_storage.py scripts/reconcile_storage.py
COPY --chown=10001:10001 scripts/apply_beta_allowances.py scripts/apply_beta_allowances.py
RUN useradd --create-home --uid 10001 studio && mkdir -p /app/data && chown studio:studio /app/data
USER studio
ENV PYTHONPATH=/app/services/control PATH=/app/.venv/bin:$PATH PYTHONUNBUFFERED=1
EXPOSE 8100
HEALTHCHECK --interval=30s --timeout=5s CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8100/healthz', timeout=4)"
CMD ["uvicorn", "studio.main:app", "--host", "0.0.0.0", "--port", "8100", "--no-proxy-headers", "--ws-max-size", "65536"]
